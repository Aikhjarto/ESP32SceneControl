# Flash / partitions
CONFIG_ESPTOOLPY_FLASHSIZE_4MB=y
CONFIG_PARTITION_TABLE_CUSTOM=y
CONFIG_PARTITION_TABLE_CUSTOM_FILENAME="partitions.csv"

# RTOS: 1 kHz tick for finer task timing
CONFIG_FREERTOS_HZ=1000
CONFIG_ESP_MAIN_TASK_STACK_SIZE=8192

# Console on UART0, 115200
CONFIG_ESP_CONSOLE_UART_DEFAULT=y
CONFIG_ESP_CONSOLE_UART_BAUDRATE=115200
CONFIG_LOG_DEFAULT_LEVEL_INFO=y

# Web server with WebSocket support
CONFIG_HTTPD_WS_SUPPORT=y
CONFIG_HTTPD_MAX_REQ_HDR_LEN=1024

# HTTP server (7 clients + 2 internal) + captive DNS + OTA download
CONFIG_LWIP_MAX_SOCKETS=16

# OTA: a new image that resets before confirming itself is rolled back by the bootloader.
# (Bootloader setting: takes effect after one serial flash.)
CONFIG_BOOTLOADER_APP_ROLLBACK_ENABLE=y

# Log lines are formatted in a 256-byte buffer on the logging task's stack (see the log
# hook in src/app/Commands.cpp); give the small system tasks that log some headroom.
CONFIG_ESP_SYSTEM_EVENT_TASK_STACK_SIZE=3584
CONFIG_LWIP_TCPIP_TASK_STACK_SIZE=4096
